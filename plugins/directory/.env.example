# Directory plugin — configuration.

# Your Discord application's PUBLIC KEY (Developer Portal → General Information).
# 64 hex chars. Used to verify interaction signatures. Required.
#
# NOTE: this is the *app* that owns the webhook the message is posted through
# (the DWEEB app, or a guild's custom app), and it is NOT a bot token.
DISCORD_PUBLIC_KEY=

# The public origin this service is reachable at (no trailing slash). DWEEB
# embeds `${PUBLIC_BASE_URL}/config.html` and the registry advertises it.
PUBLIC_BASE_URL=http://localhost:8099

# Shared secret with the interactions dispatcher (DISPATCHER_FORWARD_SECRET
# there too). It vouches for the x-dweeb-public-key header the dispatcher
# forwards, letting this plugin verify interactions from guild-registered
# CUSTOM apps with the right key. Optional; leave blank and only the primary
# key above ever verifies.
DISPATCHER_FORWARD_SECRET=

# REQUIRED in practice — the deployment-wide shared bot token. Every directory
# is READ through this bot; a server admin only ever *invites* it. Leave it blank
# and the config UI refuses to set a directory up and clicks can't read anything.
#
# No permission bit is needed, and NO PRIVILEGED INTENT: `GET /guilds/{id}`,
# `/roles` and `/channels` all work for any bot that is a member of the guild,
# and this plugin never writes. Every feature works on every deployment — there
# is nothing here to switch on in the Developer Portal.
#
# SECRET — never logged or returned to a browser.
BOT_TOKEN=

# OPTIONAL — the OAuth invite link for the shared bot above (scope=bot).
# Surfaced in the config UI as a one-click "Add the bot to your server" button.
# You only need the right app's client_id — the `permissions` are rewritten on
# startup to the shared union every DWEEB invite must carry (Discord *replaces*
# a bot's permissions on re-invite, so a narrower link would strip what other
# plugins granted). Example:
# https://discord.com/oauth2/authorize?client_id=APP_ID&scope=bot&permissions=0
BOT_INVITE_URL=

# Port to bind. Default 8099.
PORT=8099

# SQLite file path. Default ./directory.db. On a host with a persistent disk,
# point this at the mounted volume so saved directories survive restarts.
DATABASE_PATH=./directory.db

# ── Resource bounds ─────────────────────────────────────────────────────────
# All optional. A *present but unparseable* value is a hard boot error, never a
# silent fall back to the default.

# Seconds a fetched role/channel list stays warm. These are one cheap request
# each, so this mostly keeps a spammed button from hammering Discord.
# 0 disables the cache (handy while watching a live edit take effect).
STRUCTURE_CACHE_SECS=60

# Guilds that may hold a cached read at once. Bounds memory on a deployment
# serving many servers; the coldest entry is dropped past the cap.
CACHE_MAX_GUILDS=64

# Optional: log level (e.g. info, debug, dweeb_directory=debug).
RUST_LOG=info
